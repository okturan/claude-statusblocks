{
  "name": "claude-statusblocks",
  "version": "0.6.0",
  "description": "Opinionated, adaptive block-based status line for Claude Code with bin-packing layout, rate limit tracking, and campaign monitoring",
  "type": "module",
  "bin": {
    "claude-statusblocks": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "postinstall.cjs"
  ],
  "scripts": {
    "postinstall": "node postinstall.cjs",
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "preview": "node dist/cli.js preview",
    "preview:asset": "npm run build && node scripts/render-readme-preview.mjs --png"
  },
  "keywords": [
    "claude",
    "claude-code",
    "claude-ai",
    "statusline",
    "status-bar",
    "terminal",
    "cli",
    "ansi",
    "box-drawing",
    "rate-limit",
    "bin-packing",
    "layout"
  ],
  "homepage": "https://github.com/okturan/claude-statusblocks#readme",
  "bugs": {
    "url": "https://github.com/okturan/claude-statusblocks/issues"
  },
  "author": "Okan Turan",
  "repository": {
    "type": "git",
    "url": "https://github.com/okturan/claude-statusblocks"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  }
}
